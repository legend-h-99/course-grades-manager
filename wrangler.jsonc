{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "course-grades-manager",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-28",
  "routes": [
    { "pattern": "sanadapp.pro", "custom_domain": true },
    { "pattern": "www.sanadapp.pro", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/public",
    "run_worker_first": true
  },
  // Smart Placement optimizes latency; it does not guarantee data residency.
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  }
}
